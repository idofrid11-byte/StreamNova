import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory
import com.example.streamnova.data.repository.StremioApiService

@Composable
fun DetailsScreen(type: String, id: String, onPlayClick: (String) -> Unit) {
    var meta by remember { mutableStateOf<MetaItem?>(null) }
    var streams by remember { mutableStateOf<List<StreamItem>>(emptyList()) }

    LaunchedEffect(id) {
        withContext(Dispatchers.IO) {
            try {
                val retrofit = Retrofit.Builder()
                    .baseUrl("https://v3-cinemeta.strem.io/")
                    .addConverterFactory(GsonConverterFactory.create())
                    .build()
                val api = retrofit.create(StremioApiService::class.java)
                meta = api.getMeta("https://v3-cinemeta.strem.io/meta/$type/$id.json").meta

                // Fetch streams from Torrentio addon
                val streamApi = Retrofit.Builder()
                    .baseUrl("https://torrentio.strem.fun/")
                    .addConverterFactory(GsonConverterFactory.create())
                    .build()
                    .create(StremioApiService::class.java)
                streams = streamApi.getStreams("https://torrentio.strem.fun/stream/$type/$id.json").streams
            } catch (e: Exception) {
                // Handle error
            }
        }
    }

    LazyColumn(
        modifier = Modifier.fillMaxSize().padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        item {
            Text(text = meta?.name ?: "Loading...", style = MaterialTheme.typography.headlineMedium)
        }
        item {
            Text(text = meta?.description ?: "", style = MaterialTheme.typography.bodyMedium)
        }
        item {
            Text(text = "Available Streams (${streams.size})", style = MaterialTheme.typography.titleLarge)
        }
        items(streams) { stream ->
            Card(
                modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp)
            ) {
                Column(modifier = Modifier.padding(12.dp)) {
                    Text(text = stream.title ?: stream.name ?: "Stream", style = MaterialTheme.typography.bodyLarge)
                    Spacer(modifier = Modifier.height(8.dp))
                    Button(onClick = {
                        stream.url?.let { onPlayClick(it) }
                    }) {
                        Text("Play Stream")
                    }
                }
            }
