AddonRepository.kt
package com.example.streamnova.data.repository

import com.example.streamnova.data.db.AddonDao
import com.example.streamnova.data.db.AddonEntity
import com.example.streamnova.data.model.*
import kotlinx.coroutines.flow.Flow
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory

class AddonRepository(private val addonDao: AddonDao) {
    private val retrofit = Retrofit.Builder()
        .baseUrl("https://v3-cinemeta.strem.io/")
        .addConverterFactory(GsonConverterFactory.create())
        .build()

    private val api = retrofit.create(StremioApiService::class.java)

    val installedAddons: Flow<List<AddonEntity>> = addonDao.getAllAddons()

    suspend fun installAddon(manifestUrl: String): Boolean {
        try {
            val manifest = api.getManifest(manifestUrl)
            addonDao.insertAddon(
                AddonEntity(
                    manifestUrl = manifestUrl,
                    name = manifest.name,
                    version = manifest.version,
                    description = manifest.description
                )
            )
            return true
        } catch (e: Exception) {
            return false
        }
    }

    suspend fun removeAddon(manifestUrl: String) {
        addonDao.deleteAddon(manifestUrl)
    }

    suspend fun getCatalog(baseUrl: String, type: String, id: String): List<MetaItem> {
        return try {
            val url = "${baseUrl.removeSuffix("/")}/catalog/$type/$id.json"
            api.getCatalog(url).metas
        } catch (e: Exception) {
            emptyList()
        }
    }

    suspend fun getMeta(baseUrl: String, type: String, id: String): MetaItem? {
        return try {
            val url = "${baseUrl.removeSuffix("/")}/meta/$type/$id.json"
            api.getMeta(url).meta
        } catch (e: Exception) {
            null
        }
    }

    suspend fun getStreams(baseUrl: String, type: String, id: String): List<StreamItem> {
        return try {
            val url = "${baseUrl.removeSuffix("/")}/stream/$type/$id.json"
            api.getStreams(url).streams
        } catch (e: Exception) {
            emptyList()
        }
    }
}
